rules_version = '2';

// Quy tắc cho BẢN DEMO: ai cũng xem được (khách hàng mở link là thấy ngay,
// không cần đăng nhập), nhưng chỉ tài khoản đã đăng nhập mới ghi được.
// Bản triển khai thật cho từng trường sẽ siết chặt theo vai trò.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'ADMIN';
    }

    // Dữ liệu nghiệp vụ: đọc công khai, ghi khi đã đăng nhập
    match /violations/{id}   { allow read: if true; allow write: if signedIn(); }
    match /achievements/{id} { allow read: if true; allow write: if signedIn(); }
    match /auditLogs/{id}    { allow read: if signedIn(); allow create: if signedIn(); }

    // Danh mục: đọc công khai, chỉ quản trị viên được sửa
    match /classes/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /students/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /criteria/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /timeConfigs/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Hồ sơ tài khoản: đọc được để hiển thị tên người nhập liệu và tra tên đăng nhập
    match /users/{id}       { allow read: if true; allow write: if isAdmin(); }
  }
}
