rules_version = '2';

// Ảnh minh chứng: xem được công khai (link ảnh kèm token của Firebase),
// chỉ người đã đăng nhập mới tải ảnh mới lên, giới hạn 10MB và đúng định dạng ảnh.
service firebase.storage {
  match /b/{bucket}/o {
    match /violations/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
