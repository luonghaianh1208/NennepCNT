# Chép file này thành .env rồi điền giá trị thật. .env đã bị .gitignore chặn.
# Kho mã nguồn công khai — không bao giờ viết mật khẩu hay địa chỉ nội bộ vào code.

# Mật khẩu chung của các tài khoản demo (scripts/demo/*)
DEMO_PASSWORD=

# Tuỳ chọn — đuôi email của tài khoản demo, mặc định nennep.demo
DEMO_EMAIL_DOMAIN=

# Tuỳ chọn — tên trường hiện trong bản demo, mặc định "Trường THPT Demo"
DEMO_SCHOOL_NAME=

# Chỉ cần khi chạy lại scripts/demo/prepare-demo-data.ts để rút dữ liệu từ nguồn cũ
SOURCE_DATA_URL=
